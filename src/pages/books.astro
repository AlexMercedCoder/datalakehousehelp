---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import bookData from '../data/books.json';

const { intro, books, count, totalInCatalog, catalog } = bookData;
---

<StarlightPage
  frontmatter={{
    title: 'Books by Alex Merced',
    description:
      'Books on lakehouse architecture, Apache Iceberg, catalogs, and data engineering, written by Alex Merced.',
    tableOfContents: false,
  }}
>
  <p>{intro}</p>
  <p>
    {count} of {totalInCatalog} titles.
    <a href={catalog} target="_blank" rel="noopener noreferrer">See the complete catalog</a>
  </p>

  <ul class="book-list">
    {books.map((book) => (
      <li class="book-item">
        <a
          class="book-cover"
          href={book.canonicalPage}
          target="_blank"
          rel="noopener noreferrer"
          tabindex="-1"
          aria-hidden="true"
        >
          <img src={book.cover} alt="" loading="lazy" decoding="async" />
        </a>
        <div>
          <strong>
            <a href={book.canonicalPage} target="_blank" rel="noopener noreferrer">{book.title}</a>
          </strong>
          {book.publisher && <span class="book-publisher">{book.publisher}</span>}
          <p class="book-description">{book.description}</p>
          <p class="book-links">
            <a href={book.canonicalPage} target="_blank" rel="noopener noreferrer">Details</a>
            <a href={book.amazon} target="_blank" rel="noopener noreferrer">Buy on Amazon</a>
          </p>
        </div>
      </li>
    ))}
  </ul>
</StarlightPage>

<style>
  .book-list {
    list-style: none;
    padding: 0;
    margin: 2rem 0 0;
  }
  .book-item {
    display: grid;
    grid-template-columns: 5.5rem 1fr;
    gap: 1.25rem;
    align-items: start;
    padding: 0 0 1.5rem;
    margin: 0 0 1.5rem;
    border-bottom: 1px solid var(--sl-color-gray-5);
  }
  .book-cover img {
    width: 100%;
    height: auto;
    border-radius: 2px;
  }
  .book-publisher {
    display: block;
    font-size: var(--sl-text-xs);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--sl-color-gray-3);
    margin-top: 0.15rem;
  }
  .book-description {
    margin: 0.5rem 0 0.75rem;
    font-size: var(--sl-text-sm);
  }
  .book-links {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin: 0;
    font-size: var(--sl-text-sm);
    font-weight: 600;
  }
  @media (max-width: 30rem) {
    .book-item {
      grid-template-columns: 4.5rem 1fr;
      gap: 1rem;
    }
  }
</style>
