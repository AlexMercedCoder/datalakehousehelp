---
import Default from '@astrojs/starlight/components/Footer.astro';
import network from '../../network/network.json';

const { footer, cta } = network;
---

<Default {...Astro.props} />
{cta && (
	<section class="network-cta" aria-label={cta.heading}>
		<p class="network-cta__heading">{cta.heading}</p>
		<ul class="network-cta__links">
			{cta.links.map((link) => (
				<li>
					<a href={link.url} data-network-event={link.event}>{link.label}</a>
				</li>
			))}
		</ul>
	</section>
)}
<footer class="site-footer-links">
	{footer.groups.map((group) => (
		<div class="site-footer-group">
			<p class="site-footer-group__title">{group.title}</p>
			<p>
				{group.links.map((link, i) => (
					<Fragment>
						{i > 0 && ' · '}
						<a href={link.url}>{link.title}</a>
					</Fragment>
				))}
			</p>
		</div>
	))}
	<p class="site-footer-all">
		<a href={footer.allSitesUrl}>{footer.allSitesLabel}</a>
	</p>
	<p class="site-footer-newsletter">
		Two free weekly newsletters: an AI newsletter on Thursdays and an Apache lakehouse newsletter on Fridays.
		<a href="https://amdatalakehouse.substack.com">Subscribe on Substack</a>
	</p>
</footer>
<style>
	.network-cta {
		margin-top: 2rem;
		padding: 1.25rem 1rem;
		border: 1px solid var(--sl-color-gray-5);
		border-radius: 0.5rem;
		background: var(--sl-color-gray-6);
		text-align: center;
	}
	.network-cta__heading {
		margin: 0 0 0.75rem;
		font-weight: 600;
		font-size: var(--sl-text-lg);
		color: var(--sl-color-white);
	}
	.network-cta__links {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: 0.5rem 1.25rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}
	.network-cta__links a {
		color: var(--sl-color-text-accent);
		font-weight: 500;
	}
	.site-footer-links {
		padding: 1rem 0 2rem;
		text-align: center;
		font-size: var(--sl-text-sm);
		color: var(--sl-color-gray-3);
	}
	.site-footer-links a {
		color: var(--sl-color-text-accent);
	}
	.site-footer-links p {
		margin: 0;
	}
	.site-footer-group {
		margin-bottom: 0.75rem;
	}
	.site-footer-group__title {
		font-weight: 600;
		color: var(--sl-color-gray-2);
	}
	.site-footer-all {
		margin-top: 0.5rem;
	}
	.site-footer-newsletter {
		margin-top: 0.5rem;
	}
</style>
