---
import Default from '@astrojs/starlight/components/Head.astro';
import networkHead from '../../network/network-head.html?raw';
import network from '../../network/network.json';
import { fileDates } from '../lib/git-dates.mjs';

const route = Astro.locals.starlightRoute;
const entry = route?.entry;
const isSplash = entry?.data?.template === 'splash';
const canonical = new URL(Astro.url.pathname, Astro.site ?? 'https://datalakehouse.help').href;

// Build a simple breadcrumb from the URL path (Home / Section / Page)
const segments = Astro.url.pathname.split('/').filter(Boolean);
const crumbs = [{ name: 'Home', item: new URL('/', Astro.site ?? 'https://datalakehouse.help').href }];
let acc = '';
for (const seg of segments) {
  acc += '/' + seg;
  const isLast = acc === Astro.url.pathname || acc + '/' === Astro.url.pathname;
  crumbs.push({
    name: isLast && entry?.data?.title
      ? entry.data.title
      : seg.replace(/^\d+[-_]/, '').replace(/[-_]/g, ' ').replace(/\b\w/g, (c) => c.toUpperCase()),
    item: new URL(acc + '/', Astro.site ?? 'https://datalakehouse.help').href,
  });
}

const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: crumbs.map((c, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: c.name,
    item: c.item,
  })),
};

// Real content dates for the doc's source file, from src/data/git-dates.json.
const dates = entry?.filePath ? fileDates(entry.filePath) : null;

// Docs are articles; a page with no source doc (the generated /books/ list)
// is a collection page.
const articleLd = entry && !isSplash ? (dates ? {
  '@context': 'https://schema.org',
  '@type': 'TechArticle',
  ...(dates.created ? { datePublished: dates.created } : {}),
  ...(dates.modified ? { dateModified: dates.modified } : {}),
  headline: entry.data.title,
  description: entry.data.description ?? undefined,
  mainEntityOfPage: canonical,
  author: { '@id': 'https://alexmerced.com/#alexmerced' },
  publisher: { '@id': 'https://alexmerced.com/#alexmerced' },
} : {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: entry.data.title,
  description: entry.data.description ?? undefined,
  mainEntityOfPage: canonical,
  url: canonical,
  author: { '@id': 'https://alexmerced.com/#alexmerced' },
  publisher: { '@id': 'https://alexmerced.com/#alexmerced' },
}) : null;
---

<Default {...Astro.props}><slot /></Default>
<Fragment set:html={networkHead} />
{network.twitterSite && <meta name="twitter:site" content={network.twitterSite} />}
{!isSplash && (
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbLd)} />
)}
{articleLd && (
  <script type="application/ld+json" set:html={JSON.stringify(articleLd)} />
)}
